#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WRAPPER="$HOME/.local/bin/sift"
VENV="$ROOT/venv"
PYTHONPATH_LINE="export PYTHONPATH=\"$ROOT\""

if [ "$(uname -s)" != "Darwin" ]; then
    echo "Error: sift install is macOS-only." >&2
    exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "Error: Homebrew is required. Install it from https://brew.sh then re-run ./install-helper." >&2
    exit 1
fi

brew list python >/dev/null 2>&1 || brew install python
brew list ollama >/dev/null 2>&1 || brew install ollama

if ! ollama list >/dev/null 2>&1; then
    brew services start ollama
    i=0
    while [ "$i" -lt 30 ]; do
        if ollama list >/dev/null 2>&1; then
            break
        fi
        i=$((i + 1))
        sleep 1
    done
    if ! ollama list >/dev/null 2>&1; then
        echo "Error: Ollama did not start. Open the Ollama app and re-run ./install-helper." >&2
        exit 1
    fi
fi

ollama pull llama3.2:3b
ollama pull nomic-embed-text

if [ ! -x "$VENV/bin/python" ]; then
    python3 -m venv "$VENV"
fi
"$VENV/bin/pip" install -r "$ROOT/requirements.txt"

mkdir -p "$(dirname "$WRAPPER")"
cat > "$WRAPPER" <<EOF
#!/bin/sh
export PYTHONPATH="$ROOT"
exec "$VENV/bin/python" -m sift "\$@"
EOF
chmod +x "$WRAPPER"

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *)
        echo "Add ~/.local/bin to PATH, then open a new terminal:"
        echo '  export PATH="$HOME/.local/bin:$PATH"'
        ;;
esac

export PYTHONPATH="$ROOT"
"$VENV/bin/python" -m sift init
